# nltl-animate custom preset config
# Usage: nltl-animate --config nltl.yaml --preset my-preset audio.wav cover.jpg
#
# Each preset starts from another preset and only overrides the fields
# listed. `extends` defaults to "industrial"; it can name a built-in
# (industrial, clean, dark) or a custom preset defined earlier in this file.
#
# Unknown keys and out-of-range values are rejected when the file is loaded.

presets:
  - name: my-preset
    description: Custom preset for NLTL releases
    extends: industrial
    zoom_base: 1.02          # base zoom level (1–10)
    zoom_amp: 0.01           # zoom oscillation amplitude (>= 0)
    zoom_beats: 8.0          # beats per zoom breath cycle (> 0)
    jitter_amp: 2.0          # pixel micro-jitter amount (>= 0)
    blur_sigma: 0.6          # gaussian blur, 0 = sharp (0–1024)
    contrast: 1.15           # image contrast, 1 = unchanged (-1000–1000)
    saturation: 0.7          # colour saturation, 0 = monochrome, 1 = full (0–3)
    brightness_amp: 0.02     # brightness pulse amplitude (0–1)
    brightness_beats: 4.0    # beats per brightness pulse cycle (> 0)
    vignette_fraction: 0.167 # vignette angle as a fraction of PI; 0.167 = PI/6 (0–0.5)
    grain_strength: 25       # noise/grain intensity (0–100)

  # Only override what differs; everything else comes from `dark`.
  - name: my-darker
    extends: dark
    contrast: 1.4
