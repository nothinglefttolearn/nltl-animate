# nltl-animate custom grades and motions
# Usage: nltl-animate --config nltl.yaml --grade my-grade --motion slow-breath audio.wav cover.jpg
#
# A grade is how the picture looks; a motion is how it moves with the beat.
# They are chosen separately.
#
# Each entry starts from another of the same kind and only overrides the
# dials listed. `extends` defaults to "muted" for grades and "steady" for
# motions; it can name a built-in or a custom one defined earlier in this
# file. A custom one with a built-in's name replaces the built-in.
#
# Unknown keys and out-of-range values are rejected when the file is loaded.

# Grade dials are percentages; 0 leaves the image untouched.
grades:
  - name: my-grade
    description: Custom grade for NLTL releases
    extends: muted
    contrast: 15     # % change: +15 is punchier, -20 flatter (-100 to 100)
    saturation: -30  # % change: -100 is black and white (-100 to 100)
    softness: 6      # blur: 0 sharp, 100 heavily smeared (0 to 100)
    vignette: 33     # corner darkening: 0 none, 100 strongest (0 to 100)
    grain: 25        # film grain: 0 clean, 100 very heavy (0 to 100)

  # Only override what differs; everything else comes from `dark`.
  - name: my-darker
    extends: dark
    contrast: 40

# Motion strengths are percentages of the frame; rates are in beats.
# Without --bpm the beats run at 120 BPM.
motions:
  - name: slow-breath
    extends: gentle
    breath: 2          # how far the frame zooms in and out, % (0 to 50)
    breath_beats: 16   # beats per breath (> 0)
    shake: 0.1         # how far the frame drifts and jitters, % (0 to 10)
    pulse: 1           # how much brightness swells, % (0 to 100)
    pulse_beats: 8     # beats per pulse (> 0)
    shade: 0           # how much lighter or darker each image shown can be, % (0 to 50)
